generator client {
  provider        = "prisma-client-js"
  engineType      = "client" // Rust-free client: queries run through a driver adapter, no native query engine binary.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// 1. Authentication & Roles
// ---------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])
  employee      Employee?

  // Account lifecycle & security
  status             String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, PENDING
  isAdmin            Boolean   @default(false) // Full Administrator Access (granted only by a Super Admin)
  isSuperAdmin       Boolean   @default(false) // Super Admin: set only through Create / Edit User -> Details -> Access, by another Super Admin
  accessId           String? // the Access level chosen in Create / Edit User (an option of the Access field in Users -> Edit Page Layout)
  mustChangePassword Boolean   @default(false)
  sessionVersion     Int       @default(0) // bump to invalidate every session of this user
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?
  createdById        String?
  deletedAt          DateTime?

  // Vendor and payment modules: the people chosen in Task Person / Owner / Approved By
  materialVendorsAsTaskPerson    MaterialVendor[]    @relation("MaterialVendorTaskPerson")
  materialVendorsAsOwner         MaterialVendor[]    @relation("MaterialVendorOwner")
  serviceVendorsAsTaskPerson     ServiceVendor[]     @relation("ServiceVendorTaskPerson")
  serviceVendorsAsOwner          ServiceVendor[]     @relation("ServiceVendorOwner")
  prePaymentsAsTaskPerson        PrePayment[]        @relation("PrePaymentTaskPerson")
  prePaymentsAsApprover          PrePayment[]        @relation("PrePaymentApprover")
  paymentCollectionsAsTaskPerson PaymentCollection[] @relation("PaymentCollectionTaskPerson")
  paymentCollectionsAsApprover   PaymentCollection[] @relation("PaymentCollectionApprover")
  quotesAsSalesperson            Quote[]             @relation("QuoteSalesperson")
  quoteDrafts                    QuoteDraft[]

  // Attendance: the person's days (check in / out and the office and site movements)
  attendanceDays AttendanceDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([roleId])
}

model Role {
  id          String  @id @default(cuid())
  key         String? @unique // stable slug, e.g. "project_manager"
  name        String  @unique // e.g., "Manager", "Sales Executive"
  description String?
  isActive    Boolean @default(true)
  isSystem    Boolean @default(false) // cannot be renamed or deleted

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Permission {
  id          String  @id @default(cuid())
  module      String // catalog key, e.g. "leads" (legacy rows use "CRM", "My Work", ...)
  action      String // view, create, edit, delete, approve, export (legacy rows are upper case)
  description String?
  sortOrder   Int     @default(0)
  isLegacy    Boolean @default(false) // pre-catalog permission, kept for history only

  rolePermissions      RolePermission[]
  employeeOverrides    EmployeePermissionOverride[]
  temporaryPermissions TemporaryPermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       String     @default("ALLOW") // ALLOW, DENY
  scope        String?    @default("ALL") // OWN, ASSIGNED, TEAM, DEPARTMENT, PROJECT, COMPANY, ALL

  @@unique([roleId, permissionId])
}

model EmployeePermissionOverride {
  id           String     @id @default(cuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       String     @default("ALLOW") // ALLOW, DENY
  scope        String?    @default("ALL")
  reason       String?
  expiresAt    DateTime?

  createdById String?
  createdBy   Employee? @relation("OverrideCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, permissionId])
}

model TemporaryPermission {
  id           String     @id @default(cuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  effect       String     @default("ALLOW")
  scope        String?    @default("ALL")
  startsAt     DateTime
  expiresAt    DateTime

  createdById String?
  createdBy   Employee? @relation("TempPermCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccessAuditLog {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("AccessAuditEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  changedById String?
  changedBy   Employee? @relation("AccessAuditChangedBy", fields: [changedById], references: [id])

  module   String
  action   String // e.g. "VIEW", "EDIT"
  oldValue String?
  newValue String?
  scope    String?
  reason   String?

  createdAt DateTime @default(now())
}

model AccessRequest {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  requestedAccess String // e.g., "Projects -> BOQ Edit"
  module          String?
  action          String?
  reason          String

  status String @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED

  reviewedById String?
  reviewedBy   Employee? @relation("AccessRequestReviewer", fields: [reviewedById], references: [id])
  reviewNotes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model SecurityAuditLog {
  id           String   @id @default(cuid())
  actorUserId  String? // who performed the action (null for anonymous, e.g. failed login)
  action       String // USER_CREATED, LOGIN, FAILED_LOGIN, PERMISSIONS_CHANGED, ...
  targetUserId String? // whose account was affected
  ip           String?
  userAgent    String?
  oldValue     Json?
  newValue     Json?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

// ---------------------------------------------------------
// 2. HR / Team / Employees
// ---------------------------------------------------------
model Employee {
  id            String      @id @default(cuid())
  employeeCode  String?     @unique // Employee ID, e.g. "MIN-0001"
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id])
  designation   String?
  departmentId  String?
  departmentRef Department? @relation(fields: [departmentId], references: [id])
  department    String?
  contactNumber String?
  joiningDate   DateTime?
  customFields  Json? // values of the fields added in Users → Edit Page Layout, keyed by field key
  managerId     String?
  manager       Employee?   @relation("ManagerToEmployee", fields: [managerId], references: [id])
  subordinates  Employee[]  @relation("ManagerToEmployee")

  // Relations
  tasksAssigned           Task[]                @relation("TaskAssignee")
  tasksAssignedBy         Task[]                @relation("TaskAssignedBy")
  tasksSecondary          Task[]                @relation("TaskSecondaryAssignee")
  tasksVerified           Task[]                @relation("TaskVerifiedBy")
  recurringTasksAssigned  TaskRecurringSeries[] @relation("RecurringTaskAssignee")
  recurringTasksSecondary TaskRecurringSeries[] @relation("RecurringTaskSecondary")
  recurringTasksCreated   TaskRecurringSeries[] @relation("RecurringCreatedBy")
  taskComments            TaskComment[]
  taskAuditLogs           TaskAuditLog[]
  projectsManaged         Project[]             @relation("ProjectManager")
  siteVisits              SiteVisit[]
  rewards                 Reward[]
  pointTransactions       PointsLedger[]
  activities              Activity[]
  notifications           Notification[]
  enrollments             Enrollment[]
  certifications          Certification[]
  skills                  EmployeeSkill[]
  resourcesOwned          Resource[]            @relation("ResourceOwner")

  // CRM Relations
  leadsAsExec            Lead[]                       @relation("LeadSalesExecutive")
  leadsAsPerson          Lead[]                       @relation("LeadPerson")
  followUpsAssigned      FollowUp[]
  dealsAsExec            Deal[]                       @relation("DealSalesExecutive")
  quotesCreated          Quote[]                      @relation("QuoteCreatedBy")
  crmAuditLogs           CRMAuditLog[]
  // Parks / Landscaping Relations
  landscapesManaged      Landscape[]                  @relation("LandscapeManager")
  maintenancesAssigned   LandscapeMaintenance[]
  inspectionsCompleted   LandscapeInspection[]
  issuesReported         LandscapeIssue[]             @relation("IssueReportedBy")
  issuesAssigned         LandscapeIssue[]             @relation("IssueAssignedTo")
  // RBAC Relations
  permissionOverrides    EmployeePermissionOverride[]
  overridesCreated       EmployeePermissionOverride[] @relation("OverrideCreatedBy")
  tempPermissions        TemporaryPermission[]
  tempPermsCreated       TemporaryPermission[]        @relation("TempPermCreatedBy")
  accessAuditLogs        AccessAuditLog[]             @relation("AccessAuditEmployee")
  accessAuditsCreated    AccessAuditLog[]             @relation("AccessAuditChangedBy")
  accessRequests         AccessRequest[]
  accessRequestsReviewed AccessRequest[]              @relation("AccessRequestReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// 3. CRM (Leads, Customers, Contacts, Quotes, Deals)
// ---------------------------------------------------------
model Customer {
  id           String  @id @default(cuid())
  customerCode String? @unique // e.g., MIN-CUST-2026-0001
  name         String
  customerType String  @default("Individual") // Individual, Company, Builder, Architect, Interior Designer, Contractor
  email        String?
  phone        String?
  address      String?
  gstin        String? // GST number, printed on quotes
  status       String  @default("Active") // Active, Inactive

  // The Customer form (src/lib/customers). `name` is the Display Name, `phone` the Mobile, `address` the Billing Address as printed lines
  // (kept in step with the bill* columns so older screens still read it). Everything below is empty for the customers that existed before.
  salutation         String?
  firstName          String?
  lastName           String?
  companyName        String?
  workPhone          String?
  language           String?
  commEmail          Boolean  @default(false)
  commWhatsapp       Boolean  @default(false)
  gstTreatment       String? // registered_regular, consumer, overseas ...
  legalName          String?
  tradeName          String?
  placeOfSupply      String? // GST state code, 33 = Tamil Nadu
  pan                String?
  taxPreference      String? // taxable, exempt
  currency           String?
  accountsReceivable String?
  openingBalance     Decimal? @db.Decimal(14, 2)
  creditLimit        Decimal? @db.Decimal(14, 2)
  paymentTerms       String?
  portalEnabled      Boolean  @default(false)
  remarks            String?
  billAttention      String?
  billCountry        String?
  billStreet1        String?
  billStreet2        String?
  billCity           String?
  billState          String?
  billPinCode        String?
  billPhone          String?
  billFax            String?
  shipAttention      String?
  shipCountry        String?
  shipStreet1        String?
  shipStreet2        String?
  shipCity           String?
  shipState          String?
  shipPinCode        String?
  shipPhone          String?
  shipFax            String?
  customFields       Json?

  leads      Lead[]
  deals      Deal[]
  projects   Project[]
  landscapes Landscape[]
  payments   Payment[]
  resources  Resource[]
  quotes     Quote[]
  followUps  FollowUp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([phone])
  @@index([email])
  @@index([customerCode])
}

model Lead {
  id         String   @id @default(cuid())
  leadNumber String?  @unique // e.g., MIN-LEAD-2026-0001
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Property & Requirement
  propertyType String?
  siteLocation String?
  requirement  String?
  services     String? // JSON array of service names
  budgetRange  String?

  // Lead Info
  source            String?   @default("Website") // Website, Referral, Walk-in, Social Media, Exhibition, Cold Call, Google Ads
  priority          String?   @default("Medium") // Low, Medium, High
  status            String    @default("New") // New, Contacted, Requirements Collected, Preliminary Quote Sent, Follow-up, Site Visit Scheduled, Site Visit Completed, Final Quote Sent, Negotiation, Won, Lost, On Hold
  siteVisitRequired Boolean?  @default(false)
  notes             String?
  nextAction        String?
  nextActionDate    DateTime?
  lastContactedAt   DateTime?
  expectedValue     Decimal?  @db.Decimal(12, 2)

  enquiryDate DateTime @default(now())

  // Assignment (salesExecutive = "Task Assigned Person" in the Leads module)
  salesExecutiveId String?
  salesExecutive   Employee? @relation("LeadSalesExecutive", fields: [salesExecutiveId], references: [id])
  leadPersonId     String?
  leadPerson       Employee? @relation("LeadPerson", fields: [leadPersonId], references: [id])

  // ---- Leads module (/leads) ----
  leadSeq       Int?    @unique // 1, 2, 3 ... from the Counter table (never reused)
  leadCode      String? @unique // "ML" + leadSeq
  // Typed per lead (the Customer record is found/created by phone number)
  customerName  String?
  contactNumber String? // normalized: digits with optional leading +

  productOrServiceId String?
  productOrService   LeadOption? @relation("LeadProductOrService", fields: [productOrServiceId], references: [id])
  requirementId      String?
  requirementOption  LeadOption? @relation("LeadRequirement", fields: [requirementId], references: [id])
  exactRequirement   String?
  modeOfCustomerId   String?
  modeOfCustomer     LeadOption? @relation("LeadModeOfCustomer", fields: [modeOfCustomerId], references: [id])
  sourceId           String?
  sourceOption       LeadOption? @relation("LeadSource", fields: [sourceId], references: [id])

  location      String?
  exactLocation String?
  locationLink  String?

  mainCategoryId String?
  mainCategory   LeadOption? @relation("LeadMainCategory", fields: [mainCategoryId], references: [id])
  categoryId     String?
  category       LeadOption? @relation("LeadCategory", fields: [categoryId], references: [id])
  subcategoryId  String?
  subcategory    LeadOption? @relation("LeadSubcategory", fields: [subcategoryId], references: [id])

  leadStatusId String?
  leadStatus   LeadOption? @relation("LeadLeadStatus", fields: [leadStatusId], references: [id])
  leadTypeId   String?
  leadType     LeadOption? @relation("LeadLeadType", fields: [leadTypeId], references: [id])

  amount           Decimal? @db.Decimal(12, 2)
  conventionalRate Decimal? @db.Decimal(5, 2)
  dailyTask        Boolean  @default(false)

  createdById String? // User ids; always set by the server
  updatedById String?
  deletedAt   DateTime?
  closedAt    DateTime? // set while the lead is closed (Leads → Close Lead; the Status column then says Closed), empty = open. Why: LeadClosure
  convertedAt DateTime? // set when the lead was converted into a deal (Leads → Convert): it then leaves the Leads list. The deal: Deal.leadId, numbered DL1, DL2, ...

  customFields  Json? // values of custom fields added in Edit Page Layout: { "cf_xxx": value }
  attachments   LeadAttachment[]
  leadFollowUps LeadFollowUp[]
  closures      LeadClosure[]

  // Prelim Quote tracking
  prelimQuoteAmount Decimal?  @db.Decimal(12, 2)
  prelimQuoteDate   DateTime?
  prelimQuoteStatus String?   @default("Not Sent") // Not Sent, Sent, Accepted, Rejected

  // Relations
  deals        Deal[]
  siteVisits   SiteVisit[]
  followUps    FollowUp[]
  project      Project?
  landscapes   Landscape[]
  resources    Resource[]
  quotes       Quote[]
  crmAuditLogs CRMAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([customerId])
  @@index([salesExecutiveId])
  @@index([status])
  @@index([leadNumber])
  @@index([createdAt])
  @@index([nextActionDate])
  @@index([deletedAt, leadSeq])
  @@index([contactNumber])
  @@index([leadPersonId])
  @@index([leadStatusId])
  @@index([sourceId])
  @@index([mainCategoryId])
}

// One table for every Leads dropdown (source, requirement, categories, status, ...).
// Categories form a tree through parentId: MAIN_CATEGORY -> CATEGORY -> SUBCATEGORY.
// Options of every Lead pick list (system lists and custom fields). Edited through Leads → Edit Page Layout.
model LeadOption {
  id        String       @id @default(cuid())
  type      String // which pick list this option belongs to: SOURCE, REQUIREMENT, ... or "CF:<field key>" for a custom field
  key       String? // stable machine key used by filters, e.g. "open" (labels can be renamed)
  label     String
  parentId  String?
  parent    LeadOption?  @relation("LeadOptionTree", fields: [parentId], references: [id])
  children  LeadOption[] @relation("LeadOptionTree")
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)

  asProductOrService Lead[] @relation("LeadProductOrService")
  asRequirement      Lead[] @relation("LeadRequirement")
  asModeOfCustomer   Lead[] @relation("LeadModeOfCustomer")
  asSource           Lead[] @relation("LeadSource")
  asMainCategory     Lead[] @relation("LeadMainCategory")
  asCategory         Lead[] @relation("LeadCategory")
  asSubcategory      Lead[] @relation("LeadSubcategory")
  asLeadStatus       Lead[] @relation("LeadLeadStatus")
  asLeadType         Lead[] @relation("LeadLeadType")
  asDealStatus       Deal[] @relation("DealStatus")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, sortOrder])
  @@index([parentId])
  @@index([type, key])
}

// How each field on the Lead form is set up (Leads → Edit Page Layout). System fields are the original form fields;
// custom fields are added by a Super Admin and their values live in Lead.customFields.
model LeadField {
  id             String   @id @default(cuid())
  key            String   @unique // system: "customerName", ...; custom: "cf_<random>"
  label          String
  fieldType      String // TEXT, TEXTAREA, NUMBER, DATE, EMAIL, PHONE, URL, CHECKBOX, DROPDOWN, PERSON, RATE, FILE
  isSystem       Boolean  @default(false)
  required       Boolean  @default(false)
  requiredLocked Boolean  @default(false)
  defaultValue   String?
  optionType     String? // LeadOption.type for pick lists
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sortOrder])
}

// Atomic counters. The Lead ID is taken inside the same transaction that saves the lead.
model Counter {
  key       String   @id // e.g. "lead"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Auto-save of the Add Quote / Edit Quote pages. The form exactly as typed (also a half-typed row and where the cursor was). quoteId null = a NEW quote that is
// not saved yet (it holds its reserved quote number); quoteId set = the working copy of a SAVED quote being edited, which the saved quote does not see until Save.
// rev goes up at every save: a save that carries an older rev is refused. (A partial unique index on quoteNumber is in the migration.)
model QuoteDraft {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quoteId       String?
  quote         Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  state         Json
  rev           Int       @default(1)
  baseUpdatedAt DateTime? // edit: the quote's updatedAt when the working copy started
  quoteNumber   String?
  numberSeries  String?
  numberSeq     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, quoteId])
  @@index([userId, updatedAt])
}

// Quote numbers of new quotes abandoned with "Leave and Discard Changes": the next quote of the series takes the lowest one before the counter moves on.
model QuoteNumberRelease {
  series    String
  seq       Int
  createdAt DateTime @default(now())

  @@id([series, seq])
}

// Files attached to a lead. The bytes live in Supabase Storage (private bucket); only metadata is stored here.
model LeadAttachment {
  id           String        @id @default(cuid())
  leadId       String
  lead         Lead          @relation(fields: [leadId], references: [id])
  storagePath  String        @unique // leads/<leadId>/<random>.<ext>
  fileName     String // original name, display only
  mimeType     String
  size         Int
  status       String        @default("PENDING") // PENDING until the upload is verified, then READY
  uploadedById String?
  followUpId   String? // set when the file is proof for a follow-up (these are not shown as the lead's own files)
  followUp     LeadFollowUp? @relation(fields: [followUpId], references: [id])
  closureId    String? // set when the file was added while closing the lead (these are not shown as the lead's own files)
  closure      LeadClosure?  @relation(fields: [closureId], references: [id])

  // Images only (null for documents and for files uploaded before image optimization). `storagePath` is then the
  // optimized image and `size` its size; the original file is not kept.
  thumbnailPath String? @unique
  width         Int?
  height        Int?
  originalSize  Int? // size of the file the user picked, to report the saving
  contentHash   String? // SHA-256 of the file the user picked, to catch the same photo added twice

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([followUpId])
  @@index([closureId])
  @@index([leadId, contentHash])
  @@index([leadId, deletedAt])
  @@index([status, createdAt])
}

// One follow-up done on a lead (Leads → Follow-up column). It only counts once its proof files are verified (completedAt).
model LeadFollowUp {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id])
  notes       String
  nextAt      DateTime? // when the next follow-up is due
  createdById String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  attachments LeadAttachment[]

  @@index([leadId, completedAt])
}

// Leads → Actions → Close Lead: why the lead was closed, plus the optional files. It only counts once its files are
// verified (closedAt); the lead then gets the "Closed" Lead Status. A reopened lead can be closed again (a new row).
model LeadClosure {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id])
  reason     String
  closedById String? // User id of whoever closed it
  createdAt  DateTime  @default(now())
  closedAt   DateTime?

  attachments LeadAttachment[]

  @@index([leadId, closedAt])
}

// Small page-layout settings for the Leads page (e.g. the order of the table columns)
model LeadSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Users → Edit Page Layout: one JSON row ("layout") with the field labels / required flags / defaults, the order of
// the form fields and the order of the Users table columns.
model UserSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model FollowUp {
  id             String  @id @default(cuid())
  followUpNumber String? @unique // e.g., FU-2026-0001

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id])
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id])

  assignedToId String
  assignedTo   Employee @relation(fields: [assignedToId], references: [id])

  scheduledDate DateTime
  type          String   @default("Call") // Call, WhatsApp, Email, Meeting, Site Visit
  purpose       String?
  notes         String?
  nextAction    String?

  status          String    @default("Pending") // Pending, Completed, Cancelled, Rescheduled
  completedAt     DateTime?
  completionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([leadId])
  @@index([assignedToId])
  @@index([scheduledDate])
  @@index([status])
}

model Deal {
  id         String   @id @default(cuid())
  dealNumber String?  @unique // e.g., DEAL-2026-0001
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  title             String
  value             Decimal   @db.Decimal(12, 2)
  probability       Int       @default(50) // 0-100
  stage             String    @default("Qualification") // Qualification, Requirements, Preliminary Quote, Site Visit, Final Quote, Negotiation, Won, Lost
  status            String    @default("Open") // Open, Won, Lost, Cancelled
  expectedCloseDate DateTime?
  wonAt             DateTime?
  lostReason        String?

  // Deals page (Leads → Convert): the deal's own status, chosen from the DEAL_STATUS pick-list (Edit Deal Layout), and soft delete
  dealStatusId String?
  dealStatus   LeadOption? @relation("DealStatus", fields: [dealStatusId], references: [id])
  deletedAt    DateTime?

  // Projects module (Deals → Convert to Project): set when the deal became a project. A converted deal leaves the normal Deals views
  // (the Converted Deals filter shows it) and is never deleted; its project is in "projects".
  projectConvertedAt DateTime?

  // Assignment
  salesExecutiveId String?
  salesExecutive   Employee? @relation("DealSalesExecutive", fields: [salesExecutiveId], references: [id])

  quotes             Quote[]
  projects           Project[]
  resources          Resource[]
  followUps          FollowUp[]
  crmAuditLogs       CRMAuditLog[]
  prePayments        PrePayment[]
  paymentCollections PaymentCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([customerId])
  @@index([leadId])
  @@index([salesExecutiveId])
  @@index([status])
  @@index([stage])
  @@index([wonAt])
  @@index([createdAt])
  @@index([dealStatusId])
  @@index([projectConvertedAt])
}

model Quote {
  id          String  @id @default(cuid())
  quoteNumber String? @unique // e.g., QT-2026-0001

  dealId     String?
  deal       Deal?     @relation(fields: [dealId], references: [id])
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  type       String    @default("Preliminary") // Preliminary, Final
  amount     Decimal   @db.Decimal(12, 2)
  status     String    @default("Draft") // Draft, Sent, Accepted, Rejected, Expired, Cancelled
  date       DateTime  @default(now())
  expiryDate DateTime?
  notes      String?

  createdById String?
  createdBy   Employee? @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  // Quotes module (Zoho Books style quotes): header fields, who sells it, the totals panel, share link, soft delete
  reference       String?
  subject         String?
  terms           String?
  projectId       String?
  project         Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  salespersonId   String?
  salesperson     User?     @relation("QuoteSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)
  billingAddress  String?
  customerGstin   String?
  placeOfSupply   String?
  projectLocation String?
  numberSeries    String? // the quote number without its running number, e.g. QT/MSHS/26-27/A/
  numberSeq       Int? // the running number, e.g. 723
  subTotal        Decimal?  @db.Decimal(14, 2)
  discountPercent Decimal?  @db.Decimal(7, 3)
  discountAmount  Decimal?  @db.Decimal(14, 2)
  taxTotal        Decimal?  @db.Decimal(14, 2)
  shippingCharges Decimal?  @db.Decimal(14, 2)
  tdsTcsKind      String? // TDS or TCS
  tdsTcsTaxId     String?
  tdsTcsName      String?
  tdsTcsRate      Decimal?  @db.Decimal(7, 3)
  tdsTcsAmount    Decimal?  @db.Decimal(14, 2)
  adjustmentLabel String?
  adjustment      Decimal?  @db.Decimal(14, 2)
  roundOff        Decimal?  @db.Decimal(14, 2)
  retainerInvoice Boolean   @default(false)
  shareToken      String?   @unique
  shareExpiresAt  DateTime?
  customFields    Json?
  updatedById     String?
  deletedAt       DateTime?

  lineItems    QuoteItem[]
  salesOrders  SalesOrder[]
  drafts       QuoteDraft[]
  crmAuditLogs CRMAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([leadId])
  @@index([dealId])
  @@index([status])
  @@index([date])
  @@index([deletedAt])
  @@index([projectId])
  @@index([salespersonId])
  @@index([numberSeries, numberSeq])
}

model QuoteItem {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  category    String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unit        String  @default("nos")
  rate        Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(12, 2)

  // If converted to BOQ, track reference
  boqItemId String?

  // Quotes module: the line as it is shown on the quote (name, HSN, tax as they were when it was saved)
  sortOrder      Int          @default(0)
  itemId         String?
  item           CatalogItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  name           String?
  hsn            String?
  taxId          String?
  taxName        String?
  taxRate        Decimal?     @db.Decimal(7, 3)
  taxAmount      Decimal?     @db.Decimal(14, 2)
  customFields   Json?
  kind           String? // Goods or Service, as the line was saved (decides HSN or SAC)
  taskTemplateId String? // an option of the Template dropdown in Project → Edit Page Layout

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId, sortOrder])
  @@index([itemId])
}

model SalesOrder {
  id      String  @id @default(cuid())
  quoteId String
  quote   Quote   @relation(fields: [quoteId], references: [id])
  amount  Decimal @db.Decimal(12, 2)
  status  String  @default("Pending")

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteVisit {
  id          String   @id @default(cuid())
  visitNumber String?  @unique // e.g., SV-2026-0001
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id])
  assignedTo  String
  employee    Employee @relation(fields: [assignedTo], references: [id])

  siteLocation String?
  visitDate    DateTime
  visitType    String?  @default("Initial") // Initial, Follow-up, Measurement, Final
  notes        String?
  status       String   @default("Scheduled") // Scheduled, Confirmed, Completed, Rescheduled, Cancelled, No Show

  // Completion details
  completedAt  DateTime?
  actualDate   DateTime?
  visitNotes   String?
  requirements String?
  measurements String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([assignedTo])
  @@index([visitDate])
  @@index([status])
}

model CRMAuditLog {
  id String @id @default(cuid())

  entityType String // Lead, Customer, Deal, Quote, FollowUp, SiteVisit
  entityId   String
  action     String // Created, Updated, Stage Changed, Status Changed, Won, Lost, Converted

  oldValue String? // JSON
  newValue String? // JSON

  performedById String?
  performedBy   Employee? @relation(fields: [performedById], references: [id])

  // Optional entity links
  leadId  String?
  lead    Lead?   @relation(fields: [leadId], references: [id])
  dealId  String?
  deal    Deal?   @relation(fields: [dealId], references: [id])
  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([leadId])
  @@index([dealId])
  @@index([createdAt])
}

// ---------------------------------------------------------
// 4. Projects & Tasks
// ---------------------------------------------------------
model Project {
  id           String      @id @default(cuid())
  name         String
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  leadId       String?     @unique
  lead         Lead?       @relation(fields: [leadId], references: [id])
  dealId       String?
  deal         Deal?       @relation(fields: [dealId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  managerId    String
  manager      Employee    @relation("ProjectManager", fields: [managerId], references: [id])

  type            String?
  status          String    @default("Planning") // older projects: Planning, In Progress, On Hold, Completed, Cancelled. Projects module: the id of an option of the Project Status dropdown (Edit Page Layout)
  startDate       DateTime? // Projects module: Project Start Date
  expectedEndDate DateTime? // Projects module: Project Completion Date (shown as Project Validity)
  progress        Int       @default(0) // Projects module: Completion %
  value           Decimal?  @db.Decimal(12, 2)

  // Projects module (Deals → Convert to Project). A project of the module has a code; the older demo project has none.
  // Money (Project Value, Collected Amount, Expenses, Profit ...) is never stored: it is worked out from the accepted quotes, PCRs and PPRs of the deal.
  projectSeq          Int?      @unique // 1, 2, 3 ... from the Counter table (never reused)
  projectCode         String?   @unique // "MP" + projectSeq
  siteLocation        String?
  siteLocationLink    String? // a map link: the Site Location in the list opens it
  productOrService    String? // the id of the Product / Service option (the LeadOption ids lo_pos_product / lo_pos_service, or one added in Edit Page Layout)
  priorCompletionDate DateTime? @db.Date
  actualStartDate     DateTime? @db.Date
  completedDate       DateTime? @db.Date
  exclusions          Decimal?  @db.Decimal(16, 2) // taken off the profit before the incentive
  incentivePercent    Decimal?  @db.Decimal(7, 3)
  customFields        Json? // fields added in Edit Page Layout: { "cf_xxx": value }
  createdById         String?
  updatedById         String?
  deletedAt           DateTime?
  convertedAt         DateTime? // when the deal was converted

  // Relations
  tasks          Task[]
  recurringTasks TaskRecurringSeries[]
  boqItems       BoqItem[]
  expenses       Expense[]
  payments       Payment[]
  resources      Resource[]
  landscapes     Landscape[]
  quotes         Quote[]

  quoteLines        ProjectQuoteLine[]
  itemSelections    ProjectItemSelection[]
  workCoverage      ProjectWorkCoverage[]
  materialVendors   ProjectMaterialVendor[]
  serviceVendors    ProjectServiceVendor[]
  procurementBlocks ProjectProcurement[]
  procurementRows   ProjectProcurementRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt, projectSeq])
  @@index([dealId])
}

// ---------------------------------------------------------
// Projects module: the rows of the project templates (Project detail page). Each table keeps only what people type or choose;
// everything else in a template (quote values, given amounts, expenses ...) is read live from the quotes, PPRs and PCRs of the deal.
// Every table has "projectId" and "customFields" (the columns added in Project → Edit Page Layout).
// ---------------------------------------------------------

// PROJECT VALUE INFORMATION: the Exclusions typed for one accepted quote (the quote itself is read live)
model ProjectQuoteLine {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quoteId        String
  quoteExclusion Decimal? @db.Decimal(16, 2)
  customFields   Json?
  sortOrder      Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, quoteId])
}

// VENDOR SELECTION: what was chosen for one item of an accepted quote (Template, Service Vendors, Material Vendors)
model ProjectItemSelection {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quoteItemId       String
  templateId        String? // the id of an option of the Template dropdown (Project → Edit Page Layout)
  serviceVendorIds  String[] @default([])
  materialVendorIds String[] @default([])
  customFields      Json?
  sortOrder         Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, quoteItemId])
  @@index([projectId, templateId])
}

// WORK COVERAGE: the Completed tick of one template (the template's values are read live)
model ProjectWorkCoverage {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId   String
  completed    Boolean @default(false)
  customFields Json?
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, templateId])
}

// MATERIAL VENDOR INVOLVEMENT: one row per Material Vendor chosen in Vendor Selection. Its code (MP1M1, MP1M2 ...) never changes.
model ProjectMaterialVendor {
  id                   String    @id @default(cuid())
  projectId            String
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seq                  Int // 1, 2, 3 ... within the project
  materialCode         String // project code + "M" + seq
  materialVendorId     String
  materialList         String?
  materialQuotedValue  Decimal?  @db.Decimal(16, 2)
  planningToTake       DateTime? @db.Date
  takenDate            DateTime? @db.Date
  materialStatus       String? // the id of an option of the Status dropdown
  materialTaskPersonId String? // a User id
  customFields         Json?
  sortOrder            Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, seq])
  @@unique([projectId, materialCode])
  @@unique([projectId, materialVendorId])
}

// SERVICE VENDOR INVOLVEMENT: one row per Service Vendor chosen in Vendor Selection (MP1S1, MP1S2 ...)
model ProjectServiceVendor {
  id                    String    @id @default(cuid())
  projectId             String
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  seq                   Int
  serviceCode           String // project code + "S" + seq
  serviceVendorId       String
  serviceQuotedValue    Decimal?  @db.Decimal(16, 2)
  serviceStartDate      DateTime? @db.Date
  serviceStartedDate    DateTime? @db.Date
  serviceCompletionDate DateTime? @db.Date
  serviceCompletedDate  DateTime? @db.Date
  customFields          Json?
  sortOrder             Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, seq])
  @@unique([projectId, serviceCode])
  @@unique([projectId, serviceVendorId])
}

// MATERIAL PROCUREMENT: one block per material ("MATERIAL 1", "MATERIAL 2" ...) with its own item and vendor rows
model ProjectProcurement {
  id          String                  @id @default(cuid())
  projectId   String
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sortOrder   Int                     @default(0)
  quoteItemId String? // the item chosen at the top of the block (an item of the accepted quotes)
  itemLabel   String? // its name when it was chosen, shown if the quote item is gone
  rows        ProjectProcurementRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, sortOrder])
}

model ProjectProcurementRow {
  id               String             @id @default(cuid())
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blockId          String
  block            ProjectProcurement @relation(fields: [blockId], references: [id], onDelete: Cascade)
  sortOrder        Int                @default(0)
  procVendorName   String?
  procVendorNumber String?
  procLocation     String?
  procQuoteValue   Decimal?           @db.Decimal(16, 2)
  procSize         String?
  procNotes        String?
  customFields     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([blockId, sortOrder])
  @@index([projectId])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  notes       String? // shown in the Notes column of the Tasks page
  // What kind of task this is: task | lead | project | deal | office. Stored in the database, never guessed from the screen.
  taskType    String   @default("task")
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])

  // CRM & Parks references
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id])
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  dealId      String?
  deal        Deal?      @relation(fields: [dealId], references: [id])
  landscapeId String?
  landscape   Landscape? @relation(fields: [landscapeId], references: [id])
  productId   String? // typed in by the user (there is no Product table)
  customFields Json? // values of the fields added in Tasks → Edit Page Layout, keyed by field key (cf_...)

  priority   String    @default("Medium") // Low, Medium, High
  status     String    @default("Not Started") // Not Started, Assigned, In Progress, Blocked, Waiting, Completed, Verified, Closed
  dueDate    DateTime?
  startDate  DateTime?
  assignedAt DateTime  @default(now()) // when the task was given to the task person (Assigned D&T)
  startedAt  DateTime? // when work really started (Started Task)
  starred    Boolean   @default(false)

  // Assignments
  assigneeId           String?
  assignee             Employee? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignedByEmployeeId String?
  assignedBy           Employee? @relation("TaskAssignedBy", fields: [assignedByEmployeeId], references: [id])
  secondaryAssigneeId  String?
  secondaryAssignee    Employee? @relation("TaskSecondaryAssignee", fields: [secondaryAssigneeId], references: [id])

  // Completion & Verification
  requiresCompletionProof Boolean   @default(false)
  requiresVerification    Boolean   @default(false)
  verifiedById            String?
  verifiedBy              Employee? @relation("TaskVerifiedBy", fields: [verifiedById], references: [id])
  completionNotes         String?
  completedAt             DateTime?

  // Recurring Instance
  isRecurringInstance Boolean              @default(false)
  recurringSeriesId   String?
  recurringSeries     TaskRecurringSeries? @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)

  // Sub-items
  resources  Resource[]
  checklists TaskChecklistItem[]
  comments   TaskComment[]
  auditLogs  TaskAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The Tasks page filters by type + status, scopes by person, sorts by the three date columns and searches by link
  @@index([taskType, status])
  @@index([assigneeId, status])
  @@index([assignedByEmployeeId, status])
  @@index([startDate])
  @@index([dueDate])
  @@index([assignedAt])
  @@index([completedAt])
  @@index([leadId])
  @@index([projectId])
  @@index([dealId])
  @@index([customerId])
}

model TaskRecurringSeries {
  id          String  @id @default(cuid())
  title       String
  description String?

  repeatInterval Int       @default(1)
  repeatUnit     String    @default("Day") // Day, Week, Month, Year
  repeatUntil    DateTime?

  projectId           String?
  project             Project?  @relation(fields: [projectId], references: [id])
  assigneeId          String?
  assignee            Employee? @relation("RecurringTaskAssignee", fields: [assigneeId], references: [id])
  secondaryAssigneeId String?
  secondaryAssignee   Employee? @relation("RecurringTaskSecondary", fields: [secondaryAssigneeId], references: [id])

  requiresCompletionProof Boolean @default(false)
  requiresVerification    Boolean @default(false)

  instances Task[]

  createdByEmployeeId String
  createdBy           Employee @relation("RecurringCreatedBy", fields: [createdByEmployeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskChecklistItem {
  id          String   @id @default(cuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content     String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  content   String
  authorId  String
  author    Employee @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model TaskAuditLog {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  action     String // "CREATED", "STATUS_CHANGED", "ASSIGNED", "FILE_UPLOADED"
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------
// 5. Finance (BOQ, Expenses, Payments, Vendors)
// ---------------------------------------------------------
model BoqItem {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id])
  category     String // Plumbing, Electrical, Automation, etc.
  item         String
  quantity     Decimal @db.Decimal(10, 2)
  unit         String
  rate         Decimal @db.Decimal(10, 2)
  amount       Decimal @db.Decimal(12, 2)
  completedQty Decimal @default(0) @db.Decimal(10, 2)
  status       String  @default("Pending")

  // Reference back to quote item if converted
  quoteItemId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vendor {
  id          String  @id @default(cuid())
  name        String
  contactInfo String?
  serviceType String?

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  amount      Decimal   @db.Decimal(12, 2)
  paymentType String // Inbound (from customer), Outbound (to vendor)
  status      String    @default("Pending")
  date        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  description String?
  date        DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// 5b. Vendors and payment records: Material Vendor (MV1), Service Vendor (SV1), Pre-Payment Records (PPR1),
//     Payment Collection Records (PCR1). The older Vendor / Payment tables above are not used by these.
//
// Each module has its own Edit Page Layout, kept in one ModuleLayout row. The standard fields are real columns (a field's key
// is its column name); fields added in Edit Page Layout live in "customFields". A dropdown field holds the id of one of the
// options in the layout (so renaming an option never changes a record). IDs come from the Counter table (keys materialVendor,
// serviceVendor, prePayment, paymentCollection) and are never reused: records are only ever soft-deleted.
// ---------------------------------------------------------
model ModuleLayout {
  module    String   @id // materialVendor, serviceVendor, prePayment, paymentCollection
  value     Json
  updatedAt DateTime @updatedAt
}

// Files of the four modules. A file is uploaded to Storage first (recordId empty) and attached to the record when the form is saved.
model ModuleFile {
  id           String    @id @default(cuid())
  module       String
  recordId     String?
  rowId        String? // the Price Detail row the file belongs to, if any
  fieldKey     String // which file field of the layout
  storagePath  String    @unique // records/<module>/<random>.<ext>
  fileName     String
  mimeType     String
  size         Int
  status       String    @default("PENDING") // PENDING until the upload is verified, then READY
  uploadedById String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([module, recordId, deletedAt])
  @@index([rowId])
  @@index([uploadedById, status, createdAt])
}

model MaterialVendor {
  id   String @id @default(cuid())
  seq  Int    @unique // 1, 2, 3, ...
  code String @unique // MV1, MV2, ...

  companyName    String
  phone1         String?
  phone2         String?
  address        String?
  city           String?
  vendorType     String?
  shopType       String?
  taskPersonId   String?
  taskPerson     User?    @relation("MaterialVendorTaskPerson", fields: [taskPersonId], references: [id], onDelete: SetNull)
  email          String?
  exchangeRate   Decimal? @db.Decimal(18, 6)
  ownerId        String? // Categories Owner
  owner          User?    @relation("MaterialVendorOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  price          Decimal? @db.Decimal(16, 2)
  rating         String?
  subCategory    String?
  category       String?
  description    String?
  products       String?
  currency       String?
  gstNumber      String?
  sourceOfSupply String?

  customFields       Json?
  prices             MaterialVendorPrice[]
  prePayments        PrePayment[]
  paymentCollections PaymentCollection[]

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt, seq])
  @@index([taskPersonId])
  @@index([ownerId])
}

// Price Detail rows of a Material Vendor
model MaterialVendorPrice {
  id           String         @id @default(cuid())
  vendorId     String
  vendor       MaterialVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sortOrder    Int
  materialName String?
  unit         String?
  rate         Decimal?       @db.Decimal(16, 2)
  size         String?
  thickness    String?
  note         String?
  customFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, sortOrder])
}

model ServiceVendor {
  id   String @id @default(cuid())
  seq  Int    @unique // 1, 2, 3, ...
  code String @unique // SV1, SV2, ...

  name             String // Service Vendor Name
  nickName         String?
  phone1           String?
  phone2           String?
  email            String?
  address          String?
  city             String?
  vendorType       String?
  serviceLocation  String?
  taskPersonId     String?
  taskPerson       User?    @relation("ServiceVendorTaskPerson", fields: [taskPersonId], references: [id], onDelete: SetNull)
  companyName      String?
  exchangeRate     Decimal? @db.Decimal(18, 6)
  ownerId          String? // Vendor Catalogue Owner
  owner            User?    @relation("ServiceVendorOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status           String?
  serviceCategory  String?
  serviceType      String?
  rating           String?
  source           String?
  category         String?
  labourCount      Int?
  projectDriveLink String?
  currency         String?

  customFields       Json?
  prices             ServiceVendorPrice[]
  remarks            ServiceVendorRemark[]
  prePayments        PrePayment[]
  paymentCollections PaymentCollection[]

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt, seq])
  @@index([taskPersonId])
  @@index([ownerId])
}

// Price Detail rows of a Service Vendor
model ServiceVendorPrice {
  id           String        @id @default(cuid())
  vendorId     String
  vendor       ServiceVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sortOrder    Int
  serviceName  String?
  unit         String?
  rate         Decimal?      @db.Decimal(16, 2)
  areaRange    String?
  customFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, sortOrder])
}

// Remarks rows of a Service Vendor ("Remarks of Work")
model ServiceVendorRemark {
  id           String        @id @default(cuid())
  vendorId     String
  vendor       ServiceVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sortOrder    Int
  workRemarks  String?
  customFields Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, sortOrder])
}

// Pre-Payment Records (PPR1, PPR2, ...)
model PrePayment {
  id   String @id @default(cuid())
  seq  Int    @unique
  code String @unique

  dealId           String?
  deal             Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  taskPersonId     String?
  taskPerson       User?           @relation("PrePaymentTaskPerson", fields: [taskPersonId], references: [id], onDelete: SetNull)
  paymentMode      String?
  paymentType      String?
  materialVendorId String?
  materialVendor   MaterialVendor? @relation(fields: [materialVendorId], references: [id], onDelete: SetNull)
  serviceVendorId  String?
  serviceVendor    ServiceVendor?  @relation(fields: [serviceVendorId], references: [id], onDelete: SetNull)
  workTypeId       String? // Work Type: the id of a project template (an option of the Template dropdown in Project → Edit Page Layout)
  amount           Decimal?        @db.Decimal(16, 2)
  date             DateTime?       @db.Date
  paymentStatus    String?
  utrDate          DateTime?       @db.Date
  utrNumber        String? // UTR / Transaction No
  remarks          String?
  approvedById     String? // empty = "Not Yet Approved"
  approvedBy       User?           @relation("PrePaymentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  customFields Json?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt, seq])
  @@index([dealId])
  @@index([taskPersonId])
  @@index([materialVendorId])
  @@index([serviceVendorId])
  @@index([workTypeId])
  @@index([date])
}

// Payment Collection Records (PCR1, PCR2, ...): same columns as Pre-Payment Records, numbered on their own
model PaymentCollection {
  id   String @id @default(cuid())
  seq  Int    @unique
  code String @unique

  dealId           String?
  deal             Deal?           @relation(fields: [dealId], references: [id], onDelete: SetNull)
  taskPersonId     String?
  taskPerson       User?           @relation("PaymentCollectionTaskPerson", fields: [taskPersonId], references: [id], onDelete: SetNull)
  paymentMode      String?
  paymentType      String?
  materialVendorId String?
  materialVendor   MaterialVendor? @relation(fields: [materialVendorId], references: [id], onDelete: SetNull)
  serviceVendorId  String?
  serviceVendor    ServiceVendor?  @relation(fields: [serviceVendorId], references: [id], onDelete: SetNull)
  amount           Decimal?        @db.Decimal(16, 2)
  date             DateTime?       @db.Date
  paymentStatus    String?
  utrDate          DateTime?       @db.Date
  utrNumber        String?
  remarks          String?
  approvedById     String?
  approvedBy       User?           @relation("PaymentCollectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  customFields Json?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt, seq])
  @@index([dealId])
  @@index([taskPersonId])
  @@index([materialVendorId])
  @@index([serviceVendorId])
  @@index([date])
}

// ---------------------------------------------------------
// 6. Learning & Skills
// ---------------------------------------------------------
model Course {
  id          String  @id @default(cuid())
  title       String
  description String?
  category    String?
  duration    Int? // in minutes

  enrollments Enrollment[]
  sessions    LearningSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enrollment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  status     String   @default("Enrolled") // Enrolled, In Progress, Completed
  progress   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningSession {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id])
  date     DateTime
  location String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id       String  @id @default(cuid())
  name     String  @unique
  category String?

  employees EmployeeSkill[]

  createdAt DateTime @default(now())
}

model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id])
  level      String   @default("Beginner") // Beginner, Intermediate, Expert

  @@unique([employeeId, skillId])
}

model Certification {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id])
  name       String
  issuer     String?
  issueDate  DateTime?
  expiryDate DateTime?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// 7. Rewards & Points Ledger
// ---------------------------------------------------------
model Reward {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  points     Int
  reason     String
  date       DateTime @default(now())
}

model PointsLedger {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  points        Int
  source        String // Task, Project, Learning, Manual
  category      String
  referenceType String? // 'Task', 'Project', 'Course'
  referenceId   String?
  description   String?
  createdBy     String?
  approvedBy    String?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// 8. Resources (Supabase Storage Metadata)
// ---------------------------------------------------------

model Resource {
  id          String  @id @default(cuid())
  name        String
  storagePath String
  mimeType    String?
  size        Int?
  version     Int     @default(1)

  ownerId String?
  owner   Employee? @relation("ResourceOwner", fields: [ownerId], references: [id])

  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id])
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  leadId      String?
  lead        Lead?      @relation(fields: [leadId], references: [id])
  dealId      String?
  deal        Deal?      @relation(fields: [dealId], references: [id])
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id])
  landscapeId String?
  landscape   Landscape? @relation(fields: [landscapeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([storagePath])
}

// ---------------------------------------------------------
// 9. Notifications, Announcements, Misc
// ---------------------------------------------------------
model Notification {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  title      String
  message    String
  type       String // Info, Warning, Success, Alert
  isRead     Boolean  @default(false)
  link       String?

  createdAt DateTime @default(now())
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  authorId    String
  publishDate DateTime @default(now())
  status      String   @default("Published")
}

model Activity {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  action     String
  module     String
  recordId   String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------
// 10. Landscaping & Outdoor Operations (PARKS)
// ---------------------------------------------------------
model Landscape {
  id              String  @id @default(cuid())
  landscapeNumber String? @unique // e.g., LAND-2026-0001
  name            String

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])

  type     String  @default("Residential Garden") // Residential Garden, Villa Landscape, Terrace Garden, Apartment Landscape, Corporate Landscape, Commercial Landscape, Public Park, Vertical Garden, Outdoor Space, Maintenance Contract, Other
  location String?

  managerId String?
  manager   Employee? @relation("LandscapeManager", fields: [managerId], references: [id])

  startDate          DateTime?
  expectedCompletion DateTime?
  value              Decimal?  @db.Decimal(12, 2)
  description        String?
  priority           String    @default("Medium") // Low, Medium, High, Critical

  stage        String @default("Enquiry") // Enquiry, Design, Site Preparation, Plantation, Irrigation, Landscaping, Lighting, Maintenance, Completed
  status       String @default("Active") // Active, On Track, Attention, Critical, On Hold, Completed, Cancelled
  progress     Int    @default(0)
  health       Int    @default(90) // 0-100%
  healthStatus String @default("Healthy") // Healthy, Attention, Critical

  nextMaintenanceDate DateTime?

  // Relations
  plants          Plant[]
  irrigationZones IrrigationZone[]
  maintenances    LandscapeMaintenance[]
  inspections     LandscapeInspection[]
  issues          LandscapeIssue[]
  tasks           Task[]
  resources       Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([projectId])
  @@index([stage])
  @@index([status])
}

model Plant {
  id          String    @id @default(cuid())
  landscapeId String
  landscape   Landscape @relation(fields: [landscapeId], references: [id], onDelete: Cascade)

  species              String
  commonName           String?
  scientificName       String?
  category             String    @default("Shrub") // Tree, Shrub, Lawn/Turf, Groundcover, Flowering, Indoor/Potted, Climber, Succulent
  quantity             Int       @default(1)
  locationZone         String?
  plantingDate         DateTime?
  health               String    @default("Healthy") // Healthy, Attention, Critical, Dead/Replace
  waterRequirement     String    @default("Moderate") // Low, Moderate, High
  sunlightRequirement  String    @default("Full Sun") // Full Sun, Partial Shade, Full Shade
  maintenanceFrequency String    @default("Weekly") // Daily, Weekly, Bi-weekly, Monthly
  status               String    @default("Planted") // Stock, Allocated, Planted, Replacement Required

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landscapeId])
  @@index([health])
}

model IrrigationZone {
  id          String    @id @default(cuid())
  landscapeId String
  landscape   Landscape @relation(fields: [landscapeId], references: [id], onDelete: Cascade)

  zoneName        String
  controller      String? // Controller model or name
  valve           String? // Valve ID/Type
  schedule        String    @default("Daily") // Daily, Weekly, Custom
  frequency       String? // e.g. "Every morning at 06:00 AM"
  durationMinutes Int       @default(15)
  status          String    @default("Active") // Active, Paused, Attention, Off, Maintenance Needed
  lastRun         DateTime?
  nextRun         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landscapeId])
}

model LandscapeMaintenance {
  id                String    @id @default(cuid())
  maintenanceNumber String?   @unique // e.g. MAINT-2026-0001
  landscapeId       String
  landscape         Landscape @relation(fields: [landscapeId], references: [id], onDelete: Cascade)

  type         String // Watering, Pruning, Fertilizing, Grass Cutting, Pest Control, Plant Replacement, Cleaning, Irrigation Service, Lighting Service, Pergola Maintenance, General Maintenance
  assignedToId String?
  assignedTo   Employee? @relation(fields: [assignedToId], references: [id])

  dueDate     DateTime
  frequency   String    @default("One-time") // One-time, Daily, Weekly, Bi-weekly, Monthly, Quarterly, Custom
  priority    String    @default("Medium") // Low, Medium, High, Critical
  status      String    @default("Scheduled") // Scheduled, Due, In Progress, Completed, Overdue, Cancelled
  notes       String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landscapeId])
  @@index([dueDate])
  @@index([status])
}

model LandscapeInspection {
  id               String    @id @default(cuid())
  inspectionNumber String?   @unique // e.g. INSP-2026-0001
  landscapeId      String
  landscape        Landscape @relation(fields: [landscapeId], references: [id], onDelete: Cascade)

  inspectorId String?
  inspector   Employee? @relation(fields: [inspectorId], references: [id])
  date        DateTime  @default(now())
  weather     String?

  plantHealthScore Int @default(90) // 0-100
  irrigationScore  Int @default(90) // 0-100
  soilScore        Int @default(90) // 0-100
  cleanlinessScore Int @default(90) // 0-100
  safetyScore      Int @default(90) // 0-100
  overallScore     Int @default(90) // 0-100

  remarks String?
  photos  String? // JSON array of storage URLs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landscapeId])
  @@index([date])
}

model LandscapeIssue {
  id          String    @id @default(cuid())
  landscapeId String
  landscape   Landscape @relation(fields: [landscapeId], references: [id], onDelete: Cascade)

  issueTitle String
  category   String @default("General") // Plant Disease, Irrigation Failure, Water Shortage, Pest, Lighting Failure, Drainage, Soil Problem, Material Shortage, Safety, Customer Complaint, Other
  priority   String @default("Medium") // Low, Medium, High, Critical
  status     String @default("Open") // Open, In Progress, Resolved, Closed

  reportedById String?
  reportedBy   Employee? @relation("IssueReportedBy", fields: [reportedById], references: [id])
  assignedToId String?
  assignedTo   Employee? @relation("IssueAssignedTo", fields: [assignedToId], references: [id])

  description String?
  resolution  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([landscapeId])
  @@index([status])
}

// Quotes module: the items that are picked on a quote (the Item Master). The pictures of an item are ModuleFile rows of the module "item".
model CatalogItem {
  id           String    @id @default(cuid())
  name         String
  description  String?
  hsn          String? // the HSN code of Goods, the SAC of a Service
  unit         String?
  rate         Decimal   @default(0) @db.Decimal(12, 2) // the selling price
  taxId        String? // the default tax: an id from the Quote Settings
  kind         String    @default("Goods") // Goods or Service
  isActive     Boolean   @default(true)
  customFields Json?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // New Item form: classification, identifiers, inventory, returns, fulfilment, task template
  category          String?
  taxPreference     String   @default("taxable") // taxable, non_taxable, out_of_scope, non_gst
  unitGroup         String? // the id of a unit group (length, area ...) when the unit was chosen as a group
  sku               String?
  identifiers       Json? // [{ type: "UPC", value: "..." }]
  trackInventory    Boolean  @default(false)
  inventoryTracking String   @default("none") // none or batch
  inventoryAccount  String?
  valuationMethod   String   @default("fifo") // fifo or wac
  reorderPoint      Decimal? @db.Decimal(14, 2)
  returnable        Boolean  @default(false)
  dimLength         Decimal? @db.Decimal(12, 3)
  dimWidth          Decimal? @db.Decimal(12, 3)
  dimHeight         Decimal? @db.Decimal(12, 3)
  dimUnit           String   @default("cm")
  weight            Decimal? @db.Decimal(12, 3)
  weightUnit        String   @default("kg")
  taskTemplateId    String? // an option of the Template dropdown in Project → Edit Page Layout

  // Purchase Information and Default Tax Rates of the New Item form (taxId above is the Intra State Tax Rate)
  purchaseInfo        Boolean  @default(false)
  costPrice           Decimal? @db.Decimal(12, 2)
  purchaseAccount     String?
  purchaseDescription String?
  receivable          Boolean  @default(false)
  interTaxId          String? // the Inter State Tax Rate: an id from the Quote Settings

  // Imported items (Zoho Books Item.csv): its Item ID, the fields the form has no box for, and everything else the file held (nothing of it is thrown away)
  externalId   String? // the Item ID of the file the item came from; two items never share one (partial unique index)
  brand        String?
  manufacturer String?
  mrp          Decimal? @db.Decimal(12, 2)
  extra        Json? // { "Vendor": "...", "Stock On Hand": "46.00", ... } the columns of the file that have no field of their own

  quoteLines QuoteItem[]

  @@index([name])
  @@index([deletedAt, isActive])
  @@index([category])
  @@index([externalId])
}

// Quotes module: numbering, taxes, rounding, company details and templates (one JSON row per group)
model QuoteSetting {
  key       String   @id // numbering, taxes, tds, tcs, rounding, company, templates
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Attendance: one row per person per calendar day (the CRM time zone's day) with the office / site movements of that day
// ---------------------------------------------------------
model AttendanceDay {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  day         DateTime             @db.Date // the calendar day in the CRM time zone
  status      String               @default("PRESENT") // PRESENT, LEAVE, ABSENT (a day nobody marked has no row; Leave and Absent rows come from the later approval workflow / HR)
  checkInAt   DateTime?
  checkOutAt  DateTime?
  stdStartMin Int? // the office hours in force when the day was started, in minutes after midnight (09:00 = 540)
  stdEndMin   Int?
  movements   AttendanceMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
  @@index([day])
}

model AttendanceMovement {
  id            String        @id @default(cuid())
  dayId         String
  day           AttendanceDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  seq           Int // order within the day: 1, 2, 3 ...
  type          String // OFFICE_OUT, OFFICE_IN, SITE_IN, SITE_OUT
  at            DateTime
  purposeKind   String? // CODE or OTHER (asked on Office Out and Site In)
  siteVisitCode String? // SV001
  detail        String? // "SV001 - Skyline Project", or the text typed for Other

  createdAt DateTime @default(now())

  @@unique([dayId, seq])
}

// Attendance settings (one JSON row per group): "schedule" = {"start":"09:00","end":"18:30","weeklyOff":[0]}; no row = those defaults
model AttendanceSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
